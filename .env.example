# PostgreSQL 16
DATABASE_URL=postgres://user:password@localhost:5432/emissor_nf_db

# HTTP (evitar colisão com outros Nest em 3000)
API_PORT=3009

# TypeORM — synchronize true apenas em desenvolvimento
TYPEORM_SYNCHRONIZE=true
TYPEORM_LOGGING=false

# Auth (integração futura com non-saas-auth-service)
JWT_SECRET=dev-secret-key
AUTH_SERVICE_URL=http://localhost:8080
